# Copy to .env and fill in. Never commit .env.
AGRISCAN_DB_HOST=127.0.0.1
AGRISCAN_DB_PORT=3306
AGRISCAN_DB_USER=agriscan
AGRISCAN_DB_PASSWORD=change-me
AGRISCAN_DB_NAME=agriscan

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGRISCAN_SECRET_KEY=
AGRISCAN_TOKEN_TTL_MINUTES=720
AGRISCAN_PASSWORD_MIN_LENGTH=10

AGRISCAN_IMAGE_ROOT=./data/images
AGRISCAN_MODEL_ROOT=./ml/models

# Growth stage rule dat-v1 (days after transplanting at which each stage ends)
AGRISCAN_GS_VEGETATIVE_END_DAT=55
AGRISCAN_GS_REPRODUCTIVE_END_DAT=90
AGRISCAN_GS_RIPENING_END_DAT=125
AGRISCAN_GS_RULE_VERSION=dat-v1

AGRISCAN_DEMO_MODE=false

# --- ingest / gates / detector (Prompt 2) ---
AGRISCAN_MAX_UPLOAD_BYTES=15728640
AGRISCAN_QG_BLUR_VAR_MIN=100.0
AGRISCAN_QG_LUMA_MIN=40.0
AGRISCAN_QG_LUMA_MAX=215.0
AGRISCAN_QG_CLIP_FRACTION_MAX=0.25
AGRISCAN_PALAY_GATE_IMPL=stub
AGRISCAN_DETECTOR_IMPL=stub
AGRISCAN_CONF_THRESHOLD=0.50
AGRISCAN_MARGIN_THRESHOLD=0.10
AGRISCAN_STUB_DETECTOR_RESULT=
AGRISCAN_WORKER_POLL_SECONDS=2.0
AGRISCAN_WORKER_MAX_ATTEMPTS=3

# --- verification and recommendations (Prompt 4) ---
AGRISCAN_QUEUE_SAMPLE_RATE=0.10
AGRISCAN_QUEUE_CONFIDENT_MIN=0.80
AGRISCAN_PHRASER_IMPL=template
AGRISCAN_LLM_API_KEY=

# --- research metrics (p6) ---
# Below this many verified pairs, precision / recall / F1 are withheld.
AGRISCAN_METRICS_MIN_VERIFIED=30

# --- camera geometry for the mission planner (Track B) ---
# Placeholders. Measure your actual handset before planning a survey.
AGRISCAN_CAMERA_PIXEL_PITCH_UM=1.0
AGRISCAN_CAMERA_FOCAL_LENGTH_MM=4.7
AGRISCAN_CAMERA_IMAGE_WIDTH_PX=4000
AGRISCAN_CAMERA_IMAGE_HEIGHT_PX=3000
AGRISCAN_CAMERA_LABEL=UNVERIFIED_CAMERA

# --- deployment (p21) ---
# 'production' on the public server: refuses a weak secret, a blank DB password and
# active demo accounts with the published password, and stops the worker from running
# the stub detector. Leave 'development' on a laptop you are coding on.
AGRISCAN_ENV=development
# Reverse proxies in front of serve.py. 1 behind Cloudflare Tunnel or Caddy, 0 if none.
AGRISCAN_PROXY_HOPS=0
# serve.py address. Keep 127.0.0.1 behind a tunnel or proxy.
AGRISCAN_HOST=127.0.0.1
AGRISCAN_PORT=8080
AGRISCAN_LOG_DIR=./logs
AGRISCAN_WEB_DIST=../web/dist
# Sign-in limit: failures allowed per name and per address within the window.
AGRISCAN_LOGIN_MAX_FAILURES_PER_NAME=8
AGRISCAN_LOGIN_MAX_FAILURES_PER_IP=30
AGRISCAN_LOGIN_WINDOW_MINUTES=15
# A job still running after this long belongs to a worker that died.
AGRISCAN_WORKER_STALE_JOB_MINUTES=10
