# Leave VITE_API_BASE unset. The app calls /api on the same address it was loaded from:
# the Vite dev server forwards /api to Flask, and serve.py mounts the API at /api.
#
# Set it only if the API lives on a different origin entirely. It is baked into the
# build, so a value like http://127.0.0.1:5000 here would break the app on every phone.
# VITE_API_BASE=https://api.example.com
