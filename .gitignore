# --- secrets -----------------------------------------------------------------
# Never commit these. backend/.env holds the database password and the
# AGRISCAN_SECRET_KEY. Use the .env.example files as templates.
.env
.env.*
!.env.example
*.pem
*.key

# --- runtime data ------------------------------------------------------------
data/
backend/data/
backend/logs/
backend/instance/
logs/
*.sqlite
*.sqlite3
*.db

# thumbnails and previews are regenerated from the stored images
backend/data/images/_thumbs/
backend/data/images/_preview/
backend/data/images/_flights/

# --- model weights -----------------------------------------------------------
# Trained weights live in Drive (AGRISCAN_runs/<run>/weights), not in git.
ml/models/
backend/ml/
*.pt
*.onnx
*.engine
runs/

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- node / frontend ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# --- runtime media -----------------------------------------------------------
# Captured frames, flight video and session ZIPs are generated at runtime and
# live under backend/data/, ignored above.
#
# Do NOT blanket-ignore video extensions here. web/src/assets/intro.{mp4,webm}
# is a source asset that Splash.jsx imports by name; ignoring it leaves a tree
# that builds on a developer machine, where the file is merely untracked, and
# fails on any clean clone with an unresolved import.
uploads/
captures/

# --- editors / os ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
